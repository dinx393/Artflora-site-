    "next": "15.5.28",
    "nodemailer": "^10.1.2",
    "pg": "8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
