# Здесь только фото букетов: никакой код не выполняется
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|htm|html|svg)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar
Options -ExecCGI -Indexes
