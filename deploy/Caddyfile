# Caddy стоит перед сайтом: принимает https на портах 80/443, сам получает
# и продлевает сертификат Let's Encrypt и передаёт запросы сайту.
# Адрес задаётся в .env строкой DOMAIN=... (сначала new.artflora.by для проверки, потом artflora.by).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy site:3000
	log {
		output stdout
		format console
	}
}

# www.artflora.by → artflora.by
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
