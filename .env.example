# Подключение к базе PostgreSQL
DATABASE_URL="postgresql://artflora:artflora@localhost:5432/artflora?schema=public"

# Пароль для входа в админку (/admin)
ADMIN_PASSWORD="поменяйте-меня"
# Любая длинная случайная строка: ей подписывается вход в админку
SESSION_SECRET="замените-на-длинную-случайную-строку"

# Адрес сайта (для ссылок в уведомлениях). На сервере — https://artflora.by:
# по https вход в админку защищён строже.
SITE_URL="http://localhost:3000"

# Для Docker: порт на компьютере (по умолчанию 8000) и заполнение пустой базы примерами (1/0)
# SITE_PORT=8000
# SEED_DEMO=1

# Необязательно: уведомления о новых заказах в Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Необязательно: письма о новых заказах на почту. Адрес, куда слать, — в админке → «Настройки».
# Пример для Яндекс Почты: SMTP_HOST="smtp.yandex.ru", SMTP_PORT="465",
# SMTP_USER — ваш ящик, SMTP_PASS — «пароль приложения» из настроек Яндекса (не обычный пароль).
# Для Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", пароль приложения Google.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# От кого письмо (по умолчанию — SMTP_USER)
SMTP_FROM=""
